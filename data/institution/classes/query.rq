SELECT ?classe ?enlabel ?frlabel (COUNT(DISTINCT ?institution) AS ?n)
WHERE {

  VALUES ?classe {
    wd:Q15206795 wd:Q16020664 wd:Q4034417 wd:Q16038801 wd:Q1007870
    wd:Q33506 wd:Q207694 wd:Q17431399 wd:Q2087181 wd:Q1798450
    wd:Q1156831 wd:Q829080 wd:Q6815100 wd:Q713223 wd:Q7075
    wd:Q166118 wd:Q2072285 wd:Q1792630 wd:Q3280353 wd:Q2085381
    wd:Q1329623 wd:Q7315155 wd:Q2668072
  }

  ?institution wdt:P31 ?classe .

  # TELLEMENT plus rapide que le SERVICE de label...
  ?classe rdfs:label ?enlabel .
  FILTER( LANG(?enlabel)="en" )
  ?classe rdfs:label ?frlabel .
  FILTER( LANG(?frlabel)="fr" )


}
GROUP BY ?classe ?enlabel ?frlabel
ORDER BY DESC(?n)