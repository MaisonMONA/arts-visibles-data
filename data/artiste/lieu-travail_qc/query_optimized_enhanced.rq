PREFIX wd: <http://www.wikidata.org/entity/>

SELECT DISTINCT
  ?artiste
  ?nom
  (GROUP_CONCAT(DISTINCT ?lieu_travailLabel; separator=", ") AS ?lieux_travail)
  (GROUP_CONCAT(DISTINCT ?lieu_residenceLabel; separator=", ") AS ?residence)

  (GROUP_CONCAT(DISTINCT ?occupationLabel; separator=", ") AS ?occupations)
  (GROUP_CONCAT(DISTINCT ?domaine_activiteLabel; separator=", ") AS ?domaine)
  (GROUP_CONCAT(DISTINCT ?genreLabel; separator=", ") AS ?genre_artistique)
  (GROUP_CONCAT(DISTINCT ?membre_deLabel; separator=", ") AS ?membre)
  (GROUP_CONCAT(DISTINCT ?collectionLabel; separator=", ") AS ?dans_collection)
  (GROUP_CONCAT(DISTINCT ?dossierLabel; separator=", ") AS ?dossier_detenu)
  # (GROUP_CONCAT(DISTINCT ?archivageLabel; separator=", ") AS ?archives)

  (GROUP_CONCAT(DISTINCT ?sexe_ou_genreLabel; separator=", ") AS ?id_genre)
  (GROUP_CONCAT(DISTINCT ?groupe_ethniqueLabel; separator=", ") AS ?ethnicite)

WHERE {

  # valeurs injectées pour calcul sur petits ensembles
  VALUES ?occupation { wd:Q3391743 wd:Q47494964 wd:Q33231 wd:Q1028181 wd:Q1281618 wd:Q1861368 wd:Q1925963 wd:Q2865798 wd:Q3381571 wd:Q6934789 wd:Q7541856 wd:Q10774753 wd:Q15095148 wd:Q15296811 wd:Q18074503 wd:Q21178131 wd:Q21550489 wd:Q1111648 wd:Q1183704 wd:Q3374326 wd:Q10373653 wd:Q20857490 wd:Q21600439 wd:Q28947943 wd:Q644687 wd:Q1114448 wd:Q2205972 wd:Q3400050 wd:Q11079476 wd:Q11569986 wd:Q18216771 wd:Q337084 wd:Q715301 wd:Q2000124 wd:Q2544530 wd:Q3658608 wd:Q17098559 wd:Q191633 wd:Q2737906 wd:Q11606860 wd:Q59587410 wd:Q107436166 wd:Q329439 wd:Q16947657 wd:Q64213888 }
  VALUES ?lieu_travail { wd:Q176 wd:Q139497 wd:Q141810 wd:Q2304022 wd:Q764294 wd:Q809729 wd:Q931679 wd:Q1068386 wd:Q1122368 wd:Q1124109 wd:Q1607741 wd:Q1634522 wd:Q21619155 wd:Q151559 wd:Q170560 wd:Q222948 wd:Q321529 wd:Q510572 wd:Q615914 wd:Q668850 wd:Q680780 wd:Q692825 wd:Q728139 wd:Q16674321 wd:Q24847894 wd:Q61022363 wd:Q104840912 wd:Q113371057 wd:Q119025910 wd:Q119029779 wd:Q3041779 wd:Q3063786 wd:Q3219746 wd:Q141844 wd:Q141804 wd:Q321513 wd:Q1517559 wd:Q44012 wd:Q139229 wd:Q63243529 wd:Q340 wd:Q138841 wd:Q139104 wd:Q139398 wd:Q139568 wd:Q141445 wd:Q141505 wd:Q141522 wd:Q141924 wd:Q142035 wd:Q142069 wd:Q142087 wd:Q142271 wd:Q729382 wd:Q141430 wd:Q141918 wd:Q142262 wd:Q142279 wd:Q1074865 wd:Q139208 wd:Q139473 wd:Q1751092 wd:Q3152813 wd:Q3330107 wd:Q141595 wd:Q1629121 wd:Q201492 wd:Q273619 wd:Q392189 wd:Q518076 wd:Q1325316 wd:Q3010009 wd:Q3577956 wd:Q3581892 wd:Q115081583 wd:Q2936979 wd:Q99588440 wd:Q115099324 wd:Q3462113 wd:Q3462458 wd:Q952269 wd:Q3433608 wd:Q2579532 wd:Q2995979 wd:Q141558 wd:Q644468 wd:Q967488 wd:Q1579913 wd:Q3433574 wd:Q3153881 wd:Q141937 wd:Q142379 wd:Q142566 wd:Q2894274 wd:Q3130214 wd:Q3335889 wd:Q3433561 wd:Q141576 wd:Q141933 wd:Q142222 wd:Q677206 wd:Q2855336 wd:Q2872430 wd:Q2885502 wd:Q2978982 wd:Q3094824 wd:Q3207822 wd:Q3212186 wd:Q3361566 wd:Q3419589 wd:Q3462855 wd:Q3462940 wd:Q3464287 wd:Q3464288 wd:Q3464300 wd:Q3541277 wd:Q3314262 wd:Q3316990 wd:Q141731 wd:Q2820522 wd:Q3566580 wd:Q6990980 wd:Q81223838 wd:Q141699 wd:Q3282131 wd:Q3464162 wd:Q139654 wd:Q141983 wd:Q3496528 wd:Q141627 wd:Q141663 wd:Q142039 wd:Q142295 wd:Q141542 wd:Q3461933 wd:Q141927 wd:Q142001 wd:Q3464255 wd:Q141760 wd:Q141954 wd:Q142289 wd:Q1060726 wd:Q3214591 wd:Q142024 wd:Q2932587 wd:Q3204352 wd:Q3344645 wd:Q3461807 wd:Q3462013 wd:Q3462425 wd:Q3463594 wd:Q1336 wd:Q141940 wd:Q142421 wd:Q3462451 wd:Q3462942 wd:Q3464194 wd:Q139694 wd:Q142151 wd:Q280393 wd:Q511005 wd:Q3461751 wd:Q141946 wd:Q2899316 wd:Q3462457 wd:Q141977 wd:Q142284 wd:Q1622236 wd:Q2909522 wd:Q3433557 wd:Q3462421 wd:Q3463114 wd:Q141389 wd:Q1008777 wd:Q141645 wd:Q141717 wd:Q142174 wd:Q142430 wd:Q142446 wd:Q645189 wd:Q2929384 wd:Q3090573 wd:Q3126288 wd:Q3259671 wd:Q3456083 wd:Q3461925 wd:Q3461942 wd:Q3462098 wd:Q3462212 wd:Q3464147 wd:Q3464192 wd:Q3464257 wd:Q3464325 wd:Q3529001 wd:Q4137819 wd:Q141903 wd:Q142010 wd:Q142206 wd:Q142969 wd:Q953369 wd:Q2979590 wd:Q3462513 wd:Q141873 wd:Q142360 wd:Q3295063 wd:Q141764 wd:Q3356519 wd:Q139714 wd:Q543704 wd:Q771284 wd:Q957746 wd:Q139406 wd:Q141385 wd:Q141584 wd:Q141724 wd:Q1667428 wd:Q3141910 wd:Q139190 wd:Q142029 wd:Q142192 wd:Q326413 wd:Q1014394 wd:Q2879414 wd:Q3234105 wd:Q3463458 wd:Q3420451 wd:Q139588 wd:Q141998 wd:Q142117 wd:Q94285 wd:Q951911 wd:Q991143 wd:Q1012728 wd:Q1013360 wd:Q7400723 wd:Q2145 wd:Q3010003 wd:Q3464187 wd:Q142218 wd:Q170288 wd:Q3567224 wd:Q4335 wd:Q9484 wd:Q44322237 wd:Q1660491 wd:Q3088578 wd:Q112836769 wd:Q106815270 wd:Q3038062 wd:Q3009995 wd:Q56513826 wd:Q115099929 wd:Q115099897 wd:Q770125 wd:Q3559213 wd:Q3393516 wd:Q21007809 wd:Q3462503 wd:Q112855154 wd:Q14606973 wd:Q106815247 wd:Q142239 wd:Q3219804 wd:Q596644 wd:Q141705 wd:Q142355 wd:Q57312466 wd:Q66458754 wd:Q113237929 wd:Q3463286 wd:Q3463349 wd:Q3552493 wd:Q3558053 wd:Q3579109 wd:Q7590931 wd:Q2114279 wd:Q3145390 wd:Q2410305 wd:Q2936966 wd:Q3152655 wd:Q3483898 }

  ?artiste wdt:P937 ?lieu_travail .
  ?artiste wdt:P106 ?occupation .

  # voir: data/artiste/artistes_lieu-residence/query_optimized.rq
  # pour les artistes avec résidence au Québec sans lieu de travail
  OPTIONAL {
    ?artiste wdt:P551 ?lieu_residence
  }

  # timeout au-delà de 7 clauses optionnelles
  OPTIONAL {
    ?artiste wdt:P21 ?sexe_ou_genre
  }

  OPTIONAL {
    ?artiste wdt:P101 ?domaine_activite
  }

  OPTIONAL {
    ?artiste wdt:P136 ?genre
  }

  OPTIONAL {
    ?artiste wdt:P172 ?groupe_ethnique
  }

  OPTIONAL {
    ?artiste wdt:P463 ?membre_de
  }

  OPTIONAL {
    ?artiste wdt:P6379 ?collection
  }

  OPTIONAL {
    ?artiste wdt:P9493 ?dossier
  }

  # OPTIONAL {
  #   ?artiste wdt:P485 ?archivage
  # }


  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "fr,en".

    ?artiste rdfs:label ?nom .
    ?lieu_travail rdfs:label ?lieu_travailLabel .
    ?lieu_residence rdfs:label ?lieu_residenceLabel .

    ?occupation rdfs:label ?occupationLabel .
    ?domaine_activite rdfs:label ?domaine_activiteLabel .
    ?genre rdfs:label ?genreLabel .
    ?membre_de rdfs:label ?membre_deLabel .
    ?collection rdfs:label ?collectionLabel .
    ?dossier rdfs:label ?dossierLabel .
    # ?archivage rdfs:label ?archivageLabel .

    ?sexe_ou_genre rdfs:label ?sexe_ou_genreLabel .
    ?groupe_ethnique rdfs:label ?groupe_ethniqueLabel .
  }
}
GROUP BY ?artiste ?nom
ORDER BY ?lieux_travail